{
  "name": "azure-quiz-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute azure-quiz-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute azure-quiz-db --remote --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute azure-quiz-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute azure-quiz-db --remote --file=./migrations/0002_seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240900.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
